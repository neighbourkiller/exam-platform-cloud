# 复制为 .env.microservices 后填写。不要提交真实值。
MYSQL_ROOT_PASSWORD=
EXAM_DB_PASSWORD=

RABBITMQ_USERNAME=exam
RABBITMQ_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# Nacos 令牌必须是 Base64 编码且解码后不少于 32 字节。
NACOS_AUTH_TOKEN=

XXL_JOB_ACCESS_TOKEN=
XXL_JOB_ADMIN_PASSWORD=
SERVICE_CLIENT_SECRET=

# 演示账号的明文默认密码与对应的 Spring Security BCrypt 哈希。
APP_DEFAULT_PASSWORD=
APP_DEFAULT_PASSWORD_HASH=

# 可选配置。
TRUSTED_PROXY_CIDRS=
APP_RUNTIME_REPLICAS=4
APP_EXAM_ENTRY_V2_ENABLED=false
APP_TIMEOUT_SUBMISSION_V2_ENABLED=false
APP_RUNTIME_DB_MAX_POOL_SIZE=24
APP_RUNTIME_DB_MIN_IDLE=8
APP_RUNTIME_DB_CONNECTION_TIMEOUT_MS=2000
APP_TIMEOUT_SUBMISSION_BATCH_SIZE=8
APP_TIMEOUT_SUBMISSION_WORKER_COUNT=8
APP_TIMEOUT_SUBMISSION_LEASE_MS=30000
APP_TIMEOUT_SUBMISSION_MAX_RUN_MS=25000
APP_TIMEOUT_SUBMISSION_TASK_TIMEOUT_MS=20000
APP_TIMEOUT_SUBMISSION_LEASE_RENEW_INTERVAL_MS=10000
APP_TIMEOUT_SUBMISSION_BACKLOG_REFRESH_INTERVAL_MS=10000
APP_TIMEOUT_SUBMISSION_MAX_ATTEMPTS=12
