# 复制为 .env.microservices 后填写。不要提交真实值。
MYSQL_ROOT_PASSWORD=
EXAM_DB_PASSWORD=

RABBITMQ_USERNAME=exam
RABBITMQ_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# Nacos 令牌必须是 Base64 编码且解码后不少于 32 字节。
NACOS_AUTH_TOKEN=

XXL_JOB_ACCESS_TOKEN=
XXL_JOB_ADMIN_PASSWORD=
SERVICE_CLIENT_SECRET=

# 演示账号的明文默认密码与对应的 Spring Security BCrypt 哈希。
APP_DEFAULT_PASSWORD=
APP_DEFAULT_PASSWORD_HASH=

# 可选配置。
TRUSTED_PROXY_CIDRS=
APP_RUNTIME_REPLICAS=4
APP_EXAM_ENTRY_V2_ENABLED=false
APP_TIMEOUT_SUBMISSION_V2_ENABLED=false
